{
  "name": "@arnaud-zg/configs",
  "version": "0.1.3",
  "description": "Shareable dev-tooling configs: ESLint, Prettier, tsconfig, tsdown, Lefthook, and remark.",
  "keywords": [
    "eslint-config",
    "prettier-config",
    "tsconfig",
    "tsdown",
    "lefthook",
    "remark-lint",
    "monorepo",
    "shareable-config"
  ],
  "homepage": "https://github.com/arnaud-zg/configs#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/configs.git"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/node-vitest.json": "./tsconfig/node-vitest.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/react-vite.json": "./tsconfig/react-vite.json",
    "./tsconfig/react-vite-storybook.json": "./tsconfig/react-vite-storybook.json",
    "./tsconfig/react-vitest.json": "./tsconfig/react-vitest.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./tsconfig/react-native-vitest.json": "./tsconfig/react-native-vitest.json",
    "./tsconfig/react-native-vite-storybook.json": "./tsconfig/react-native-vite-storybook.json",
    "./tsconfig/internal-package.json": "./tsconfig/internal-package.json",
    "./tsdown": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./lefthook/lefthook.yml": "./lefthook/lefthook.yml",
    "./lefthook/check-commit-msg.sh": "./lefthook/check-commit-msg.sh",
    "./remark": "./remark/index.mjs"
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "tsconfig",
    "tsdown",
    "lefthook",
    "remark",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "remark . --frail --quiet",
    "prepack": "pnpm build",
    "prepare": "lefthook install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vitest.json --noEmit"
  },
  "prettier": "./prettier/index.js",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "@ianvs/prettier-plugin-sort-imports": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "lefthook": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "prettier-plugin-packagejson": {
      "optional": true
    },
    "remark-cli": {
      "optional": true
    },
    "remark-preset-lint-recommended": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
