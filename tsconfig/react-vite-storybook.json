{
  /**
   * React Web Storybook Configuration with Vite
   * Extends the React configuration with Storybook-specific settings
   * for creating component documentation with Storybook in React web projects.
   */
  "extends": "./react.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "types": ["node", "vite/client", "vite-plugin-svgr/client"]
  },
  "exclude": [
    /* Test Files */
    "${configDir}/src/**/*.spec.ts",
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/**/*.spec.js",
    "${configDir}/src/**/*.test.js",
    "${configDir}/src/**/*.spec.tsx",
    "${configDir}/src/**/*.test.tsx",
    "${configDir}/src/**/*.spec.jsx",
    "${configDir}/src/**/*.test.js",
    /* Test Directories */
    "${configDir}/**/__tests__/**/*.ts",
    "${configDir}/**/__tests__/**/*.tsx"
  ],
  "include": [
    /* Storybook Files */
    "${configDir}/src/**/*.stories.ts",
    "${configDir}/src/**/*.stories.js",
    "${configDir}/src/**/*.stories.jsx",
    "${configDir}/src/**/*.stories.tsx",
    "${configDir}/src/**/*.stories.mdx",
    /* Storybook Configuration */
    "${configDir}/.storybook/*.js",
    "${configDir}/.storybook/*.ts",
    "${configDir}/.storybook/*.tsx",
    "${configDir}/.storybook/**/*.js",
    "${configDir}/.storybook/**/*.ts",
    "${configDir}/.storybook/**/*.tsx",
    /* Type Definitions */
    "${configDir}/src/@types/*.d.ts"
  ]
}
